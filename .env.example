# Example environment variables for treasureHunt
# Copy this to .env and fill in secrets before running in production.

# MongoDB (used by docker-compose mongodb service)
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_INITDB_DATABASE=treasureHunt_auth

# Server
SERVER_PORT=8080
DATABASE_NAME=treasureHunt_auth

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# OpenAI (for embeddings / LLM integration)
OPENAI_API_KEY=
