# Example environment variables for treasureHunt
# Copy this to .env and fill in secrets before running in production.

# MongoDB (used by docker-compose mongodb service)
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_INITDB_DATABASE=treasureHunt_auth

# Server
SERVER_PORT=8080
DATABASE_NAME=treasureHunt_auth

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Email Whitelist Control
# Set to true/1/yes/enabled to enable email whitelist restriction
# Set to false/0/no/disabled or leave empty to allow anyone to sign up
ENABLE_EMAIL_WHITELIST=false

# Email Whitelist (only used if ENABLE_EMAIL_WHITELIST=true)
# Comma-separated list of allowed emails for signup
# Example: EMAIL_WHITELIST=user1@example.com,user2@example.com,admin@company.com
EMAIL_WHITELIST=

# OpenAI (for embeddings / LLM integration)
OPENAI_API_KEY=
